{
  "name": "vesperal",
  "productName": "Vesperal",
  "version": "0.22.0",
  "description": "Vesperal: A Última Chama — metroidvania 2D de fantasia sombria (versão de computador)",
  "author": "Lourence Manuel",
  "license": "CC-BY-NC-SA-4.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "copiar-jogo": "node scripts/copiar-jogo.js",
    "start": "npm run copiar-jogo && electron .",
    "steam:windows": "npm run copiar-jogo && electron-builder --win",
    "steam:linux": "npm run copiar-jogo && electron-builder --linux",
    "steam:mac": "npm run copiar-jogo && electron-builder --mac",
    "exe:windows": "npm run copiar-jogo && electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "pt.lourencemanuel.vesperal",
    "productName": "Vesperal",
    "copyright": "© 2026 Lourence Manuel",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/icon.png",
      "game/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "vesperal",
      "category": "Game"
    },
    "mac": {
      "target": [
        {
          "target": "dir"
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.role-playing-games"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vesperal",
      "artifactName": "Vesperal-${version}-instalador-windows.${ext}"
    },
    "portable": {
      "artifactName": "Vesperal-${version}-windows-portatil.${ext}"
    }
  }
}
